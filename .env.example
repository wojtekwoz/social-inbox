# Social Inbox configuration. Copy to .env for local dev; in Coolify set these in the env UI.
# Never commit real values.

# --- server
PORT=8787
PUBLIC_URL=https://inbox.wozu.co
DB_PATH=./data/inbox.db
LOG_LEVEL=info

# --- safety (defaults shown)
# Kill switch: approved drafts are only executed when true.
SENDING_ENABLED=false
# Who approved drafts may reach, on top of SENDING_ENABLED (covers manual and automation drafts):
#   off     = nothing is sent (default; also when unset, EVEN IF SENDING_ENABLED=true)
#   testers = only recipients on SEND_ALLOWLIST; others are refused (draft failed, audited, no retry)
#   all     = everyone (the pre-SEND_MODE behaviour)
# Upgrading with SENDING_ENABLED=true? Set SEND_MODE=all to keep sending.
SEND_MODE=off
# Comma-separated IGSIDs and/or usernames, case-insensitive, leading @ optional.
# The recipient is the DM counterpart, or the author of the comment being replied to / private-replied
# to / hidden / unhidden / deleted. Fake example: SEND_ALLOWLIST=@tester_one,6000000000000001
SEND_ALLOWLIST=
# human = approve only via CLI/REST with an approve-scoped key.
# agent-confirmed = also exposes an MCP `approve` tool that requires confirmedBy + chat ref.
APPROVAL=human
MAX_SENDS_PER_HOUR=30

# --- API keys (generate with: node -e "console.log('sk_'+require('crypto').randomBytes(32).toString('base64url'))")
# Agent key: scopes read,draft,send (send only executes approved drafts).
SINBOX_AGENT_KEY=
# Admin/human key: all scopes incl. approve. Keep it on your Mac / password manager only.
SINBOX_ADMIN_KEY=

# --- token encryption: 32 bytes as 64 hex chars (openssl rand -hex 32)
TOKEN_ENC_KEY=

# --- polling
POLL_ENABLED=true
# Demo/testing only: deterministic fake items.
FAKE_CONNECTOR=false

# --- retention
RETENTION_RAW_DAYS=30
RETENTION_TEXT_DAYS=365

# --- Meta / Instagram (Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
# Optional: Login configuration id from "Facebook Login for Business > Configurations".
META_LOGIN_CONFIG_ID=
# Optional: pick a specific Facebook Page if several are granted.
META_PAGE_ID=
META_GRAPH_VERSION=v24.0
META_BACKFILL_DAYS=30
# Webhooks need a Live app + Advanced Access; keep off in dev mode.
META_WEBHOOKS_ENABLED=false
WEBHOOK_VERIFY_TOKEN=
# Separate Meta feature (7-day window). Only enable once granted.
META_HUMAN_AGENT=false

# --- automations (M5, docs/SPEC-automations.md). All off by default.
# Global kill switch for the rules engine (comment/DM keyword flows, buttons, email capture).
AUTOMATIONS_ENABLED=false
# Lets mode "auto" flows approve their own drafts as system:automation.
# They are still only executed when SENDING_ENABLED=true and SEND_MODE allows the recipient.
AUTOMATIONS_AUTOSEND=false
# One automated message per contact per flow step within this many hours.
AUTOMATIONS_COOLDOWN_HOURS=24

# --- email list providers for the push_email step (provider is off while its key is empty)
PLUNK_API_KEY=
# Hosted Plunk by default; set your self-hosted Plunk API URL instead if you run one.
PLUNK_API_URL=https://api.useplunk.com
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Shown on /privacy
PRIVACY_CONTACT=
